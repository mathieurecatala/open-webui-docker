# Valeurs de DÉVELOPPEMENT uniquement. Copier en .env : cp .env.example .env
# En production, remplacer chaque mot de passe et la clé secrète par des valeurs longues et aléatoires
# (par exemple : openssl rand -hex 32). Le fichier .env n'est jamais versionné.

# Versions épinglées (jamais main ni latest). scripts/mettre-a-jour.sh modifie OPEN_WEBUI_VERSION.
OPEN_WEBUI_VERSION=v0.11.4
OLLAMA_VERSION=0.40.2
POSTGRES_VERSION=17.11-alpine
CADDY_VERSION=2.11.7-alpine

# Adresse publique servie par Caddy. "localhost" = certificat local auto-signé (dev).
# En production : le nom de domaine réel (ex. assistant.mon-entreprise.fr) => certificat Let's Encrypt automatique.
SITE_ADDRESS=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Base Postgres d'Open WebUI
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=dev-mot-de-passe-postgres

# Clé de signature des sessions Open WebUI (dev)
WEBUI_SECRET_KEY=dev-cle-secrete-a-changer

# Premier compte administrateur, créé par scripts/initialiser.sh
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev-mot-de-passe-admin

# Modèle local servi par Ollama (CPU, gratuit, environ 1 Go)
OLLAMA_MODEL=qwen2.5:1.5b
# Emplacement des modèles téléchargés : volume Docker nommé par défaut,
# ou un chemin (ex. ./cache-ollama) pour le mettre en cache dans la CI.
OLLAMA_VOLUME=ollama

# Facultatif : API compatible OpenAI à la place (ou en plus) d'Ollama. Laisser vide par défaut.
# Ne JAMAIS écrire de vraie clé dans ce fichier : seulement dans .env (ignoré par Git).
OPENAI_API_BASE_URL=
OPENAI_API_KEY=
